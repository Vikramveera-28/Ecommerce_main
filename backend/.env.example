# MongoDB only
# IMPORTANT: host must be your Atlas *cluster* name (e.g. cluster0.xxxxx.mongodb.net),
# NOT the database name. Copy the string from Atlas → Connect → Drivers.
USE_MONGO_ONLY=true
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Ecommerce
MONGODB_DB_NAME=ecommerce
JWT_SECRET_KEY=change-me
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=14
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URI=memory://
CORS_ORIGINS=*
SEED_ADMIN_EMAIL=admin@seed.local
SEED_ADMIN_PASSWORD=admin12345
SEED_LOGISTICS_EMAIL=logistics@seed.local
SEED_LOGISTICS_PASSWORD=logistics12345
SEED_DELIVERY_BOY_EMAIL=delivery@seed.local
SEED_DELIVERY_BOY_PASSWORD=delivery12345
