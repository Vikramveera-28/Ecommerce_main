# Primary database (recommended for full app features on Render: link a Postgres instance)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# MongoDB (optional; auth routes only — catalog/orders/cart still require SQLAlchemy/Postgres)
# Set USE_MONGO_ONLY=true and MONGODB_URI, OR put a mongodb:// / mongodb+srv:// URI in DATABASE_URL.
USE_MONGO_ONLY=false
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Ecommerce
MONGODB_DB_NAME=ecommerce
JWT_SECRET_KEY=change-me
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=14
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URI=memory://
CORS_ORIGINS=*
SEED_ADMIN_EMAIL=admin@seed.local
SEED_ADMIN_PASSWORD=admin12345
SEED_LOGISTICS_EMAIL=logistics@seed.local
SEED_LOGISTICS_PASSWORD=logistics12345
SEED_DELIVERY_BOY_EMAIL=delivery@seed.local
SEED_DELIVERY_BOY_PASSWORD=delivery12345
